# Copy to .env and fill in. NEVER commit the real .env file.
# Used by docker-compose.yml and as a reference for running the backend directly.

# --- Database (MySQL 8+) ---
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=dailyflow
DB_PASSWORD=change-me-db

# --- Backend ---
# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Time zone used to decide what "today" means for tasks (e.g. Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
# Browser origin(s) allowed by CORS (comma separated). With docker-compose the app is served from one origin.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Set to false in production to hide Swagger UI and /v3/api-docs
SPRINGDOC_ENABLED=true

# --- Optional email reminders ---
# Email reminders are enabled ONLY when SPRING_MAIL_HOST is defined. Keep these lines commented out to disable.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@dailyflow.local

# --- Ports published by docker-compose ---
WEB_PORT=8081
